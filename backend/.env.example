# ==========================================
# Kiwi Learning Environment Variables
# ==========================================

# Resend Email Configuration (SMTP)
# 1. Sign up at https://resend.com
# 2. Grab an API key starting with 're_' from API Keys dashboard
# 3. Paste it here:
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Address
# For testing before adding a domain, Resend requires: 'Kiwi Learning <onboarding@resend.dev>'
# (and only allows sending to the email address registered on your Resend account).
# Once your domain is verified on Resend, you can use e.g. 'Kiwi Learning <login@yourdomain.com>'
DEFAULT_FROM_EMAIL="Kiwi Learning <onboarding@resend.dev>"

# Frontend URL (Used to build the magic login verification link)
FRONTEND_URL=http://localhost:5173

# Django Settings (Defaults are fine for local dev)
DJANGO_SECRET_KEY=django-insecure-_xcs+kj@-&d9of4=@=x)6gcvo+botgnutjfrsklv=vl*ttjpw_
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
